# Copy to .env.local using the actual values from your Convex development setup.
# `bunx convex dev` can select your existing project and write deployment values.
CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment-name.convex.site
VITE_SITE_URL=http://localhost:3000

# Set these on the Convex development deployment, not in this browser env file:
# SITE_URL=http://localhost:3000
# BETTER_AUTH_SECRET=<a securely generated random secret>
# Never prefix a secret with VITE_; Vite exposes those values to the browser.
